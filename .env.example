# ─────────────────────────────────────────────────────────────────────────────
# Variables d'environnement — copier vers .env.local puis compléter.
# .env.local est ignoré par git, ce fichier ne l'est PAS : il doit être commité.
#
# Où trouver les clés : Supabase Dashboard → Project Settings → API
# ⚠️ Ne JAMAIS commiter .env.local, ni exposer SUPABASE_SECRET_KEY côté client.
# ─────────────────────────────────────────────────────────────────────────────

# URL du projet, visible côté client (utile pour @supabase/ssr).
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co

# Clé anon. Bypass RLS : SEULEMENT côté serveur.
# Utilisée par @supabase/ssr pour la session admin.
SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# Clé secrète. Bypass RLS, accès total aux tables.
# Utilisée pour toutes les lectures/écritures de l'app.
# NE JAMAIS l'exposer dans un composant client. Cf. docs/ARCHITECTURE.md § 1.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxx

# Anciens noms encore acceptés par Supabase, si ton projet utilise l'ancien
# format des clés :
# SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxx
